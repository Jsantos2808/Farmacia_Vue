MONGODB_DATABASE=pharmacy
# Local Compose replica set:
MONGODB_URI=mongodb://mongo:27017/pharmacy?replicaSet=rs0
# Atlas (production): mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/pharmacy?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
PORT=3000
